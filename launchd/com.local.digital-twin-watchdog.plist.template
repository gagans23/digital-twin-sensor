<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.digital-twin-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>__VENV_BIN__/digital-twin-sensor</string>
    <string>watchdog</string>
    <string>--fix</string>
    <string>--stale-after</string>
    <string>180</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.digital-twin-sensor/watchdog.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.digital-twin-sensor/watchdog.err.log</string>
</dict>
</plist>
